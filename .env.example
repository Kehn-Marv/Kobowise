# ============================================
# KOBOWISE ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================

# --- Telegram Bot ---
# Get this from @BotFather on Telegram
# 1. Open Telegram, search @BotFather
# 2. Send /newbot → name it "Kobowise" → username "KobowiseBot"
# 3. Copy the token here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# The token for your private Admin bot
ADMIN_BOT_TOKEN=your_admin_bot_token_here

# Your personal Telegram ID (use @userinfobot to get it)
MASTER_ADMIN_ID=your_telegram_id_here

# --- Google Gemini AI ---
# Get a free API key at: https://aistudio.google.com/apikey
# Free tier: 1,500 requests/day, 1M tokens/min (very generous!)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Turso Database ---
# Sign up at: https://turso.tech
# Create a database, then get URL + auth token
# CLI: turso db create kobowise
#      turso db tokens create kobowise
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Admin ---
# Secret key for admin API endpoints (e.g., activating premium for users)
# Change this to something secure!
ADMIN_SECRET=kobowise-admin-2026
